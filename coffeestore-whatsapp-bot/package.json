{
  "name": "coffeestore-whatsapp-bot",
  "version": "1.0.0",
  "description": "Standalone Automated WhatsApp Business Bot for CoffeeStore Q8",
  "main": "dist/server/index.js",
  "scripts": {
    "build": "tsc && npm run copy-public",
    "copy-public": "mkdir -p dist/public && cp -r src/public/* dist/public/",
    "start": "node dist/server/index.js",
    "dev": "tsx watch src/server/index.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "qrcode": "^1.5.4",
    "whatsapp-web.js": "^1.26.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.16.5",
    "@types/qrcode": "^1.5.5",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}

